# Required — lowercase, no spaces, unique on host. Used in container/image names
# and the Traefik router.
COMPOSE_PROJECT_NAME=srv_dark-oberon
# Required — host name with a DNS record pointing to the VPS (HTTPS via Traefik).
PROJECT_WEBSITE=oberon.cloud.digitalmind.cz
# Optional — where the live game count comes from, and which GitHub repo has the releases.
LOBBY_URL=https://oberon-game.cloud.digitalmind.cz
GITHUB_REPO=jakubfrieb/dark-oberon
