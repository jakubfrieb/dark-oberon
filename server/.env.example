# Copy to server/.env (gitignored) and adjust. docker compose reads .env from the directory
# of docker-compose.yml, so it must sit next to it (server/.env), not in the repo root.
# All values are optional; the defaults are shown.

# Compose project name (container/network names). Keep it stable once deployed.
COMPOSE_PROJECT_NAME=dark-oberon

# Host port for the lobby web UI, and the port gunicorn listens on inside the container.
WEB_HOST_PORT=8080
WEB_PORT=8080

# TCP port range for game server instances (published 1:1 on the host).
PORT_RANGE_START=17000
PORT_RANGE_END=17009

# Public hostname/IP game clients connect to (shown in the lobby). Empty = not shown.
GAME_PUBLIC_HOST=

# Gunicorn access log: - = stdout, /dev/null = quiet.
GUNICORN_ACCESS_LOG=-

# --- Lobby accounts ---------------------------------------------------------------
# Session signing key. Empty = generated on first start and kept in the lobby-data volume.
LOBBY_SECRET_KEY=

# Reverse proxies in front of the lobby (e.g. 1 behind Traefik). Needed for correct client IPs,
# which the sign-up / sign-in rate limits use. 0 = clients connect to the lobby directly.
TRUSTED_PROXIES=0

# 1 = send the session cookie only over HTTPS. Set to 1 when the lobby is served via HTTPS.
SESSION_COOKIE_SECURE=0

# Stop a game when no human player has been connected for this many minutes.
LOBBY_IDLE_MINUTES=30

# Stop any game after this many hours.
LOBBY_MAX_GAME_HOURS=8
