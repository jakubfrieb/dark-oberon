# Copy to server/.env (gitignored) and adjust. docker compose reads .env from the directory
# of docker-compose.yml, so it must sit next to it (server/.env), not in the repo root.
# All values are optional; the defaults are shown.

# Compose project name (container/network names). Keep it stable once deployed.
COMPOSE_PROJECT_NAME=dark-oberon

# Host port for the lobby web UI, and the port gunicorn listens on inside the container.
WEB_HOST_PORT=8080
WEB_PORT=8080

# TCP port range for game server instances (published 1:1 on the host).
PORT_RANGE_START=17000
PORT_RANGE_END=17009

# Public hostname/IP game clients connect to (shown in the lobby). Empty = not shown.
GAME_PUBLIC_HOST=

# Gunicorn access log: - = stdout, /dev/null = quiet.
GUNICORN_ACCESS_LOG=-
