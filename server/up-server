#!/usr/bin/env bash
set -euo pipefail
SERVER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE="$SERVER_DIR/docker-compose.yml"
# Compose Bake requires buildx; without it every build prints a WARN — the classic builder is enough.
export COMPOSE_BAKE=false

usage() {
  echo "Usage: ${0##*/} [--build | --rebuild]" >&2
  echo "  --build    docker compose up --build (cached, fast C++ recompile)" >&2
  echo "  --rebuild  docker compose build --no-cache, then up (full rebuild)" >&2
  exit 1
}

MODE=up
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --build)
      MODE=build
      ;;
    --rebuild)
      MODE=rebuild
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      ;;
  esac
  shift
done

case "$MODE" in
  rebuild)
    docker compose -f "$COMPOSE" build --no-cache
    exec docker compose -f "$COMPOSE" up --remove-orphans
    ;;
  build)
    exec docker compose -f "$COMPOSE" up --build --remove-orphans
    ;;
  *)
    exec docker compose -f "$COMPOSE" up --remove-orphans
    ;;
esac
