# Copy to .env (gitignored) and fill in.
# Used by .cursor/skills/dark-oberon-codex scripts for image generation
# (run_openai_board_batch.py and the codex CLI fallback).

OPENAI_API_KEY=sk-...

# Optional: image model override (default: gpt-image-1.5).
# Use gpt-image-1 if your org is not yet verified for gpt-image-1.5.
#OPENAI_IMAGE_MODEL=gpt-image-1.5
