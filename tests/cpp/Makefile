CXX ?= g++
SRC = ../../src

SDL2_CFLAGS := $(shell pkg-config --cflags sdl2)
SDL2_LIBS := $(shell pkg-config --libs sdl2)

test: test_ai_logic test_dofile test_perf test_netwire
	./test_ai_logic
	./test_dofile
	./test_perf
	./test_netwire

test_ai_logic: test_ai_logic.cpp $(SRC)/doai_logic.cpp $(SRC)/doai_logic.h
	$(CXX) -std=gnu++17 -Wall -Wextra -O1 -I$(SRC) -o $@ test_ai_logic.cpp $(SRC)/doai_logic.cpp

# Config-file parser, built with ASan so a buffer overflow fails the test.
test_dofile: test_dofile.cpp $(SRC)/dofile.cpp $(SRC)/dofile.h
	$(CXX) -std=gnu++17 -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer \
	  -w -DUNIX=1 -DSOUND=0 -DDEBUG=0 -DHEADLESS=0 -I$(SRC) $(SDL2_CFLAGS) \
	  -o $@ test_dofile.cpp $(SRC)/dofile.cpp $(SDL2_LIBS)

# Simulation step statistics (performance tests).
test_perf: test_perf.cpp $(SRC)/doperf.cpp $(SRC)/doperf.h
	$(CXX) -std=gnu++17 -Wall -Wextra -O1 -I$(SRC) $(SDL2_CFLAGS) -o $@ test_perf.cpp $(SRC)/doperf.cpp $(SDL2_LIBS)

# Network wire format (protocol version 2), built with ASan (no vptr check: TPLAYER is not linked).
NETWIRE_SRC = $(SRC)/doevents.cpp $(SRC)/donet.cpp $(SRC)/dohost.cpp $(SRC)/doipc.cpp $(SRC)/utils.cpp
test_netwire: test_netwire.cpp $(NETWIRE_SRC) $(SRC)/donet.h $(SRC)/doevents.h $(SRC)/dohost.h | $(SRC)/build_info.h
	$(CXX) -std=gnu++17 -O1 -g -fsanitize=address,undefined -fno-sanitize=vptr -fno-omit-frame-pointer \
	  -w -DUNIX=1 -DSOUND=0 -DDEBUG=0 -DHEADLESS=0 -I$(SRC) $(SDL2_CFLAGS) \
	  -o $@ test_netwire.cpp $(NETWIRE_SRC) $(SDL2_LIBS)

# Generated by the game's Makefile (version string of the trailer).
$(SRC)/build_info.h:
	$(MAKE) -C $(SRC) build_info.h

clean:
	rm -f test_ai_logic test_dofile test_perf test_netwire

.PHONY: test clean
