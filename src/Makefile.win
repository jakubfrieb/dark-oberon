# Windows (x86_64) cross-build with MinGW-w64.
#
#   sudo scripts/setup-windows-toolchain.sh   # once: mingw-w64-gcc, wine, zip
#   scripts/fetch-windows-deps.sh             # once: SDL2 + SDL2_mixer for MinGW
#   make windows                              # from repo root -> dist/dark-oberon-<ver>-win64.zip
#
# Objects go to obj-win/ so they never mix with the Linux .o files.
# Without -DUNIX, cfg.h defines WINDOWS and the original Win32 code paths are used.

SOUND ?= 1
DEBUG ?= 0
# CONSOLE=1 keeps a console window (stdout/stderr visible) for debugging.
CONSOLE ?= 0

CROSS ?= x86_64-w64-mingw32-
CXX = $(CROSS)g++
WINDRES = $(CROSS)windres

WIN_DEPS ?= ../third_party/win64
OBJDIR = obj-win
EXE = ../dark-oberon.exe

CPPFLAGS = -O2 -Wall -Wno-unused -Wno-write-strings -Wno-parentheses -Wno-register
DEFINES = -DDATA_DIR='""' -DSOUND=$(SOUND) -DDEBUG=$(DEBUG) -DHEADLESS=0
INCLUDES = -I$(WIN_DEPS)/include -I$(WIN_DEPS)/include/SDL2

# Fully static C/C++ runtime (libgcc, libstdc++, winpthread); SDL stays a DLL
# via its explicit import library (-l:lib*.dll.a is honoured under -static).
LDFLAGS = -L$(WIN_DEPS)/lib -static
ifeq ($(CONSOLE),0)
LDFLAGS += -mwindows
endif
LIBRARIES = -lmingw32 -lSDL2main -l:libSDL2.dll.a -lopengl32 -lglu32 -lws2_32
ifeq ($(SOUND),1)
LIBRARIES += -l:libSDL2_mixer.dll.a
endif

# Same object list as the Linux client (src/Makefile).
SOURCES = doalloc doberon dobuildings doconfig dodata dodevcheat dodraw doai doai_logic doengine doevents dofactories dofight dofile dofollower doforces doglfw_sdl dohost doipc dolayout doleader dologs domap domapunits domouse donet doperf doplayers doraces doschemes doselection dosimpletypes dosound dosources dounits dowalk doworkers glfont glgui tga utils
OBJECTS = $(addprefix $(OBJDIR)/,$(addsuffix .o,$(SOURCES)))

all: $(EXE)

$(EXE): $(OBJECTS)
	$(CXX) $(OBJECTS) $(LDFLAGS) $(LIBRARIES) -o $@

# build_info.h (VERSION + git hash) is generated by the main Makefile first;
# the root `make windows` target does that.
$(OBJDIR)/%.o: %.cpp *.h | $(OBJDIR)
	$(CXX) $(CPPFLAGS) $(DEFINES) $(INCLUDES) -c $< -o $@

$(OBJDIR):
	mkdir -p $@

clean:
	rm -rf $(OBJDIR) $(EXE)

.PHONY: all clean
