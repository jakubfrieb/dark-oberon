SOUND ?= 1
DEBUG ?= 0
HEADLESS ?= 0

CPP = g++ $(CPPFLAGS) $(INCLUDES) $(DEFINES)
CPPFLAGS = -g -Wall -O
DEFINES = -DDATA_DIR='""' -DUNIX=1 -DSOUND=$(SOUND) -DDEBUG=$(DEBUG) -DHEADLESS=$(HEADLESS)

# When SOUND/HEADLESS change, force rebuild (otherwise stale dosound.o keeps SDL_mixer refs while link uses no -lSDL2_mixer).
COMPILE_FLAGS_STAMP := .compile_flags
$(COMPILE_FLAGS_STAMP): FORCE
	@printf '%s\n' "SOUND=$(SOUND)" "HEADLESS=$(HEADLESS)" > $(COMPILE_FLAGS_STAMP).new
	@if test -f $(COMPILE_FLAGS_STAMP) && cmp -s $(COMPILE_FLAGS_STAMP).new $(COMPILE_FLAGS_STAMP); then rm -f $(COMPILE_FLAGS_STAMP).new; else mv $(COMPILE_FLAGS_STAMP).new $(COMPILE_FLAGS_STAMP); fi
FORCE:
SDL2_CFLAGS := $(shell pkg-config --cflags sdl2 2>/dev/null || sdl2-config --cflags 2>/dev/null)
SDL2_LIBS := $(shell pkg-config --libs sdl2 2>/dev/null || sdl2-config --libs 2>/dev/null)
SDL2_MIXER_CFLAGS := $(shell pkg-config --cflags SDL2_mixer 2>/dev/null)
SDL2_MIXER_LIBS := $(shell pkg-config --libs SDL2_mixer 2>/dev/null)
ifeq ($(strip $(SDL2_MIXER_LIBS)),)
SDL2_MIXER_LIBS = -lSDL2_mixer
endif
INCLUDES = $(SDL2_CFLAGS)
LIBPATHS =
LIBRARIES = -pthread -lGL -lGLU $(SDL2_LIBS)
ifeq ($(SOUND),1)
INCLUDES += $(SDL2_MIXER_CFLAGS)
LIBRARIES += $(SDL2_MIXER_LIBS)
endif
# Dedicated server is always SOUND=0; do not link SDL2_mixer (LIBRARIES is parsed before target-specific SOUND).
SERVER_LIBRARIES = -pthread -lGL -lGLU $(SDL2_LIBS)
OBJECTS = doalloc.o doberon.o dobuildings.o doconfig.o dodata.o dodevcheat.o dodraw.o doai.o doai_logic.o doengine.o doevents.o dofactories.o dofight.o dofile.o dofollower.o doforces.o doglfw_sdl.o dohost.o doipc.o dolayout.o doleader.o dologs.o domap.o domapunits.o domouse.o donet.o doplayers.o doraces.o doschemes.o doselection.o dosimpletypes.o dosound.o dosources.o dounits.o dowalk.o doworkers.o glfont.o glgui.o tga.o utils.o
OBJECTS_SERVER = $(filter-out doberon.o,$(OBJECTS)) doserver.o
TARGETS = ../dark-oberon

$(OBJECTS) doserver.o: $(COMPILE_FLAGS_STAMP)

BUILD_INFO = build_info.h

# Version string + git short hash for in-game About line (see CreateMenuGUI).
build_info.h: Makefile
	@v=$$(cd .. && git rev-parse --short HEAD 2>/dev/null); \
	test -n "$$v" || v=unknown; \
	{ echo '/* Generated by Makefile - do not edit. */'; \
	  echo '#define DO_VERSION_STRING "1.0.2-RC1"'; \
	  printf '#define DO_GIT_REVISION "%s"\n' "$$v"; \
	} > $@.tmp && mv $@.tmp $@

# First target above is build_info.h; without this, plain `make` / `make -jN` would only refresh it.
.DEFAULT_GOAL := all

all: $(BUILD_INFO) ../dark-oberon checking

checking: .checking
.checking: *.h *.cpp
	@echo Checking format of source files...
	@if grep -E -l "`printf '\t'`|`printf '\r'`" *.cpp *.h; then echo "Error: Previous listed files contain illegal characters (tabs or ^M)"; false; fi
	@echo OK
	@touch .checking

clean: 
	rm -f $(OBJECTS) doserver.o $(TARGETS) ../dark-oberon-server *core core.* tags $(BUILD_INFO) $(COMPILE_FLAGS_STAMP)

# Same .o names as client but different -DHEADLESS/-DSOUND; always wipe before server link.
# After `make server`, rebuild the GUI client with `make clean && make` (or `make ../dark-oberon`).
clean-server:
	rm -f $(OBJECTS) doserver.o ../dark-oberon-server

tags: *.h *.cpp
	-exctags * 2> /dev/null || ctags * 2> /dev/null

docs:
	rm -rf ../docs/documentation/html_local
	doxygen .doxygen.conf 2>&1 | tee .doxygen.log

../dark-oberon: $(OBJECTS)
	$(CPP) $(OBJECTS) $(LIBPATHS) $(LIBRARIES) -o ../dark-oberon

# Dedicated headless server (relay leader); glgui still compiled with HEADLESS=0 for GL texture paths.
server: $(BUILD_INFO)
	@$(MAKE) clean-server
	@$(MAKE) HEADLESS=1 SOUND=0 ../dark-oberon-server

# Building the server object tree must use HEADLESS=1 (not only `make server` recursive invoke).
../dark-oberon-server: HEADLESS = 1
../dark-oberon-server: SOUND = 0
../dark-oberon-server: $(OBJECTS_SERVER)
	$(CPP) $(OBJECTS_SERVER) $(LIBPATHS) $(SERVER_LIBRARIES) -o ../dark-oberon-server

